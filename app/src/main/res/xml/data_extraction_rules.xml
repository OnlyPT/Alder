<?xml version="1.0" encoding="utf-8"?>
<!-- No backup and no device transfer: profiles keep sign-in keys and PINs, and searches and last-played files are kept
     per profile id, so a restore would hand them to whoever gets that id next (issue 89). allowBackup="false" stops
     cloud backup; on Android 12+ it does not stop device transfer for apps that target 31+, so this file does. -->
<data-extraction-rules>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
